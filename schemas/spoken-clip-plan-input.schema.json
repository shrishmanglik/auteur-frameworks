{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "script": {
      "type": "string",
      "minLength": 1
    },
    "performanceCue": {
      "type": "string",
      "minLength": 1
    },
    "supportedDurationsSeconds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "paceWpm": {
      "type": "number",
      "minimum": 60,
      "maximum": 240
    },
    "leadInSeconds": {
      "default": 0.15,
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "terminalSettleSeconds": {
      "default": 0.55,
      "type": "number",
      "minimum": 0.25,
      "maximum": 3
    },
    "timingSlackPercent": {
      "default": 8,
      "type": "number",
      "minimum": 0,
      "maximum": 25
    }
  },
  "required": [
    "script",
    "performanceCue",
    "supportedDurationsSeconds",
    "paceWpm"
  ],
  "additionalProperties": false
}
